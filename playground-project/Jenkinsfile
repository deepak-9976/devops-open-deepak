pipeline {
	 agent any
	 tools {
        maven 'Maven3'
      }
    environment {
        PROJECT_ID = 'project-8bac9238-f889-40b2-ba4'
        CLUSTER_NAME = 'gke-deep-dive'
        LOCATION = 'europe-west1-b'
        CREDENTIALS_ID = 'jenkins-sa-key'
    }
    stages {
        stage('Build Maven') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'git@github.com:deepak-9976/devops-open-deepak.git']]])
				dir("playground-project") {
                    sh "pwd"
                    sh 'mvn clean install'
                }
            }
        }
        
        }    
}
