pipeline {
    agent any
    environment {
        PROJECT_ID = 'argon-potential-459218-r7'
        CLUSTER_NAME = 'gke-deep-dive'
        LOCATION = 'europe-west1-b'
        CREDENTIALS_ID = 'jenkins-sa-key'
    }
    stages {
        stage('Build Maven') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[url: 'http://deepak-tech.com:3000/devops/playground-project.git']]])
                sh 'mvn clean install'
            }
        }
        stage('Build docker image') {
            steps {
                script {
                    sh 'docker build -t docker.io/deepak9976/playground-image:latest .'
                }
            }
        }
        stage('Push image to hub') {
            steps {
                script {
                    sh 'docker login -u <username> -p <password>
                    sh 'docker push docker.io/deepak9976/playground-image:latest' // Corrected line
                }
            }
        }
        stage('Deploy on K8s Cluster') {
            steps {
step([$class: 'KubernetesEngineBuilder', projectId: env.PROJECT_ID, clusterName: env.CLUSTER_NAME, location: env.LOCATION, manifestPattern: 'manifests.yaml', credentialsId: env.CREDENTIALS_ID, verifyDeployments: true])
		   echo "Deployment Finished ..."
                }
            }
        }    
}
